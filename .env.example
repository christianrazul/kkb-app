POSTGRES_DB=kkb
POSTGRES_USER=kkb
POSTGRES_PASSWORD=replace-with-a-long-random-password

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

SITE_ADDRESS=https://kkb-app.space
APP_FRONTEND_URL=https://kkb-app.space
SESSION_COOKIE_SECURE=true
# Set only when an existing reverse proxy owns ports 80 and 443.
# SHARED_PROXY_NETWORK=pharmacy-pos_edge

APP_TIME_ZONE=Asia/Manila
FX_BASE_URL=https://api.frankfurter.dev
FX_TIMEOUT=5s
FX_PREFETCH_CRON="0 30 1 * * *"

BACKUP_DIR=/var/backups/kkb
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
